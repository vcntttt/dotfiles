#!/usr/bin/env bash
# Cambia la rotación de un monitor en caliente.
#
# Uso:
#   monitor-rotate                    # lista monitores y su rotación actual
#   monitor-rotate <output>           # muestra rotación actual del monitor
#   monitor-rotate <output> <rot>     # establece rotación (0-3 o "toggle")
#   monitor-rotate <output> toggle    # alterna entre 0 (normal) y 1 (vertical)
#
# rot:
#   0 = normal
#   1 = 90°  (vertical, sentido horario)
#   2 = 180° (invertido)
#   3 = 270° (vertical, sentido antihorario)
#
# Requiere: hyprctl, jq

set -euo pipefail

command -v hyprctl &>/dev/null || { echo "hyprctl no encontrado"; exit 1; }
command -v jq &>/dev/null || { echo "jq no encontrado"; exit 1; }

# --- Obtener datos de monitores ---
monitors_json="$(hyprctl monitors all -j 2>/dev/null || hyprctl monitors -j 2>/dev/null)"

list_monitors() {
  echo "$monitors_json" | jq -r '
    .[] | "\(.name)  transform=\(.transform)  \(.width)x\(.height)  disabled=\(.disabled // false)"
  '
}

get_transform() {
  local output="$1"
  local val
  val="$(echo "$monitors_json" | jq -r ".[] | select(.name == \"$output\") | .transform // empty")"
  if [[ -z "$val" ]]; then
    echo "Monitor '$output' no encontrado." >&2
    exit 1
  fi
  echo "$val"
}

# --- Sin argumentos: listar ---
if [[ $# -eq 0 ]]; then
  echo "Monitores disponibles:"
  list_monitors
  echo ""
  echo "Uso: monitor-rotate <output> [0|1|2|3|toggle]"
  exit 0
fi

output="$1"

# --- Validar que el monitor existe ---
if ! echo "$monitors_json" | jq -e ".[] | select(.name == \"$output\")" &>/dev/null; then
  echo "Monitor '$output' no encontrado." >&2
  echo "Monitores disponibles:" >&2
  list_monitors >&2
  exit 1
fi

# --- Solo output: mostrar estado ---
if [[ $# -eq 1 ]]; then
  current="$(get_transform "$output")"
  echo "$output: transform=$current"
  exit 0
fi

rot="$2"

# --- toggle: alternar entre 0 y 1 ---
if [[ "$rot" == "toggle" ]]; then
  current="$(get_transform "$output")"
  if [[ "$current" == "0" ]]; then
    rot=1
  else
    rot=0
  fi
  echo "$output: $current -> $rot"
fi

# --- Validar rotación ---
case "$rot" in
  0|1|2|3) ;;
  *)
    echo "Rotación inválida: '$rot'. Usa 0, 1, 2, 3 o toggle." >&2
    exit 1
    ;;
esac

# --- Obtener specs actuales del monitor ---
read -r width height refresh x y scale current_transform <<< "$(echo "$monitors_json" | jq -r "
  .[] | select(.name == \"$output\")
  | \"\(.width) \(.height) \(.refreshRate) \(.x) \(.y) \(.scale) \(.transform // 0)\"
")"

# Hyprland expone el modo físico sin intercambiar width/height al rotar,
# pero la caja lógica sí cambia. Si no actualizamos las posiciones vecinas,
# queda un hueco entre pantallas y el ratón/foco no puede cruzarlo.
logical_width() {
  local transform="$1"
  if (( transform % 2 == 1 )); then
    echo "$height"
  else
    echo "$width"
  fi
}

logical_height() {
  local transform="$1"
  if (( transform % 2 == 1 )); then
    echo "$width"
  else
    echo "$height"
  fi
}

old_logical_width="$(logical_width "$current_transform")"
old_logical_height="$(logical_height "$current_transform")"
new_logical_width="$(logical_width "$rot")"
new_logical_height="$(logical_height "$rot")"
delta_x=$((new_logical_width - old_logical_width))
delta_y=$((new_logical_height - old_logical_height))
target_right=$((x + old_logical_width))
target_bottom=$((y + old_logical_height))

# Aplicar la rotación mediante la API Lua de Hyprland. Desde Hyprland 0.55,
# el parser de configuración de monitores antiguo ya no está disponible.
lua_monitor_calls=()
add_monitor_call() {
  local monitor_name="$1"
  local monitor_width="$2"
  local monitor_height="$3"
  local monitor_refresh="$4"
  local monitor_x="$5"
  local monitor_y="$6"
  local monitor_scale="$7"
  local monitor_transform="$8"
  local mode="${monitor_width}x${monitor_height}"
  local lua_name lua_mode lua_position

  monitor_refresh="${monitor_refresh%.*}"
  if [[ "$monitor_refresh" -gt 0 ]]; then
    mode="${mode}@${monitor_refresh}"
  fi
  lua_name="$(printf '%s' "$monitor_name" | jq -Rr '@json')"
  lua_mode="$(printf '%s' "$mode" | jq -Rr '@json')"
  lua_position="$(printf '%sx%s' "$monitor_x" "$monitor_y" | jq -Rr '@json')"
  lua_monitor_calls+=("hl.monitor({ output = $lua_name, mode = $lua_mode, position = $lua_position, scale = $monitor_scale, transform = $monitor_transform })")
}

add_monitor_call "$output" "$width" "$height" "$refresh" "$x" "$y" "$scale" "$rot"

# Ajustar únicamente monitores que estaban en la misma fila o columna y
# después del borde afectado. Así se conserva el layout del resto.
while IFS=$'\t' read -r monitor_name monitor_width monitor_height monitor_refresh monitor_x monitor_y monitor_scale monitor_transform; do
  [[ "$monitor_name" == "$output" ]] && continue

  new_x="$monitor_x"
  new_y="$monitor_y"
  if [[ "$monitor_y" -eq "$y" && "$monitor_x" -ge "$target_right" ]]; then
    new_x=$((monitor_x + delta_x))
  elif [[ "$monitor_x" -eq "$x" && "$monitor_y" -ge "$target_bottom" ]]; then
    new_y=$((monitor_y + delta_y))
  fi

  if [[ "$new_x" != "$monitor_x" || "$new_y" != "$monitor_y" ]]; then
    add_monitor_call "$monitor_name" "$monitor_width" "$monitor_height" "$monitor_refresh" "$new_x" "$new_y" "$monitor_scale" "$monitor_transform"
  fi
done < <(echo "$monitors_json" | jq -r '.[] | [.name, .width, .height, .refreshRate, .x, .y, .scale, (.transform // 0)] | @tsv')

hyprctl eval "$(IFS='; '; echo "${lua_monitor_calls[*]}")"

echo "  $output -> rotación $rot aplicada"
if (( delta_x != 0 || delta_y != 0 )); then
  echo "  geometría adyacente ajustada: Δx=$delta_x Δy=$delta_y"
fi
