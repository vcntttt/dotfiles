#!/usr/bin/env bash
# Traduce bloques monitorv2 { ... } a sintaxis estándar de Hyprland.
#
# Formato monitorv2:
#   monitorv2 {
#     output = <nombre>
#     mode   = <resolución>[@<hz>]   (default: preferred)
#     position = <posición>           (default: auto)
#     scale  = <factor>               (default: 1)
#     transform = <0|1|2|3>           (default: 0, opcional)
#   }
#
# transform:
#   0 = normal
#   1 = 90°  (vertical, sentido horario)
#   2 = 180° (invertido)
#   3 = 270° (vertical, sentido antihorario)
#
# Uso: monitorv2 < archivo.conf
#      cat archivo.conf | monitorv2
#
# Las líneas que no pertenecen a un bloque monitorv2 se pasan sin cambios.

set -euo pipefail

state=0  # 0 = fuera de bloque, 1 = dentro de bloque monitorv2
name=""
mode="preferred"
position="auto"
scale="1"
transform="0"

while IFS= read -r line || [[ -n "$line" ]]; do
  # Recortar espacios
  trimmed="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

  # --- Detectar inicio de bloque monitorv2 ---
  if [[ "$trimmed" == "monitorv2 {" ]]; then
    state=1
    name=""
    mode="preferred"
    position="auto"
    scale="1"
    transform="0"
    continue
  fi

  # --- Dentro del bloque ---
  if [[ $state -eq 1 ]]; then
    # Fin del bloque
    if [[ "$trimmed" == "}" ]]; then
      if [[ -n "$name" ]]; then
        if [[ "$transform" == "0" ]]; then
          echo "monitor = $name, $mode, $position, $scale"
        else
          echo "monitor = $name, $mode, $position, $scale, transform, $transform"
        fi
      fi
      state=0
      continue
    fi

    # Saltar líneas vacías dentro del bloque
    [[ -z "$trimmed" ]] && continue
    # Saltar comentarios dentro del bloque
    [[ "$trimmed" == \#* ]] && continue

    # Parsear key = value
    key="$(echo "$trimmed" | cut -d= -f1 | sed 's/[[:space:]]*$//')"
    value="$(echo "$trimmed" | cut -d= -f2- | sed 's/^[[:space:]]*//')"

    if [[ -z "$key" ]]; then
      continue
    fi

    case "$key" in
      output)    name="$value" ;;
      mode)      mode="$value" ;;
      position)  position="$value" ;;
      scale)     scale="$value" ;;
      transform) transform="$value" ;;
      *)         ;; # ignorar claves desconocidas
    esac
    continue
  fi

  # --- Fuera de bloque: pasar la línea sin cambios ---
  echo "$line"
done
