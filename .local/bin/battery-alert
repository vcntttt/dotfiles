#!/usr/bin/env bash
# Notify when the notebook battery reaches low levels.

set -euo pipefail

BATTERY_NAME="${BATTERY_NAME:-BAT0}"
BATTERY_PATH="/sys/class/power_supply/$BATTERY_NAME"
INTERVAL_SECONDS="${BATTERY_ALERT_INTERVAL:-60}"
WARNING_LEVEL="${BATTERY_WARNING_LEVEL:-30}"
CRITICAL_LEVEL="${BATTERY_CRITICAL_LEVEL:-15}"
FULL_LEVEL="${BATTERY_FULL_LEVEL:-100}"

if [[ ! -d "$BATTERY_PATH" ]]; then
  exit 0
fi

if ! command -v notify-send >/dev/null 2>&1; then
  echo "battery-alert: notify-send not found" >&2
  exit 1
fi

last_level=""

while true; do
  capacity="$(<"$BATTERY_PATH/capacity")"
  status="$(<"$BATTERY_PATH/status")"
  level=""

  if [[ "$status" == "Discharging" ]]; then
    if (( capacity <= CRITICAL_LEVEL )); then
      level="critical"
    elif (( capacity <= WARNING_LEVEL )); then
      level="warning"
    fi
  elif [[ "$status" == "Charging" || "$status" == "Full" ]]; then
    if (( capacity >= FULL_LEVEL )); then
      level="full"
    fi
  fi

  if [[ -n "$level" && "$level" != "$last_level" ]]; then
    if [[ "$level" == "critical" ]]; then
      notify-send -u critical "Bateria critica" "Queda ${capacity}%. Conecta el cargador."
    elif [[ "$level" == "full" ]]; then
      notify-send -u normal "Bateria cargada" "Ya esta al ${capacity}%. Puedes desconectar el cargador."
    else
      notify-send -u normal "Bateria baja" "Queda ${capacity}%."
    fi
  fi

  last_level="$level"
  sleep "$INTERVAL_SECONDS"
done
